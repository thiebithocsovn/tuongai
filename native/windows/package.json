{
  "name": "tuong-hoc-tap-ai-desktop",
  "productName": "Tường học tập AI",
  "version": "1.0.0",
  "description": "Ứng dụng Windows cho Tường học tập AI – Truy gốc lỗi",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "vn.tuonghoctap.ai.desktop",
    "productName": "Tường học tập AI",
    "asar": true,
    "files": ["main.cjs", "package.json"],
    "directories": {"output": "../../native-artifacts"},
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}],
      "icon": "../../icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Tuong-Hoc-Tap-AI-Windows.exe"
    }
  }
}
